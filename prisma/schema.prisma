// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  priceCents     Int
  salePriceCents Int?
  description    String
  images         String[]
  // Teksty alternatywne sparowane z images po indeksie — puste wpisy zastępuje
  // opis wyliczony z tytułu (lib/product-images.ts).
  imageAlts      String[]         @default([])
  sortOrder      Int              @default(0)
  sizeChartId    String?
  sizeChart      SizeChart?       @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  size      String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

// Jeden wiersz (id zawsze "singleton") — ustawienia baneru Hero na stronie głównej.
model Hero {
  id     String  @id @default("singleton")
  type   String // "image" | "video"
  src    String
  alt    String?
  poster String?
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  customerEmail  String
  customerName   String
  phone          String
  deliveryMethod String
  address        String?
  postalCode     String?
  city           String?
  inpostPoint    String?
  paymentMethod  String
  // "oczekuje" | "oplacone" | "nieudane" — status realnej bramki (na razie HotPay);
  // inne metody płatności nie są jeszcze zintegrowane, więc dostają "oplacone" od razu.
  paymentStatus  String      @default("oplacone")
  paymentRef     String?
  subtotalCents  Int
  discountCents  Int         @default(0)
  totalCents     Int
  status         String      @default("nowe")
  items          OrderItem[]
  createdAt      DateTime    @default(now())

  @@index([customerEmail])
}

model OrderItem {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String
  title       String
  image       String
  size        String
  quantity    Int
  priceCents  Int
}

// Szablon tabeli rozmiarów — jeden na krój (np. „Koszulka oversize”), przypisywany wielu produktom.
model SizeChart {
  id           String    @id @default(cuid())
  name         String
  illustration String?
  sizes        String[]
  rows         Json // [{ label: "A", description: "Długość", values: ["69", "72", ...] }]
  note         String?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
