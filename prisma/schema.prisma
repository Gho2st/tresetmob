// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  priceCents     Int
  salePriceCents Int?
  description    String
  images         String[]
  // Teksty alternatywne sparowane z images po indeksie — puste wpisy zastępuje
  // opis wyliczony z tytułu (lib/product-images.ts).
  imageAlts      String[]              @default([])
  sortOrder      Int                   @default(0)
  // Data premiery ustawiana w panelu — po niej sortuje „Najnowsze”, bo
  // createdAt to tylko moment dodania rekordu, nie wejścia rzeczy do sprzedaży.
  releasedAt     DateTime              @default(now())
  sizeChartId    String?
  sizeChart      SizeChart?            @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  priceHistory   ProductPriceHistory[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  size      String
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([productId, size])
}

// Cena, po której produkt faktycznie był sprzedawany (promocyjna, jeśli była),
// zapisywana przy każdej jej zmianie. Z tego liczymy najniższą cenę z 30 dni
// przed obniżką, którą wymaga dyrektywa Omnibus (lib/price-history.ts).
model ProductPriceHistory {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  priceCents Int
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

// Pojedyncze grafiki redakcyjne, każda pod własnym id: "singleton" to baner Hero
// na stronie głównej, "login" to zdjęcie przy formularzu logowania (lib/hero.ts).
model Hero {
  id     String  @id @default("singleton")
  type   String // "image" | "video"
  src    String
  alt    String?
  poster String?
}

// Token do API Instagrama. Leży w bazie, a nie w zmiennej środowiskowej, bo
// żyje 60 dni i cron musi móc wpisać na jego miejsce nowy — procesowi nie wolno
// nadpisać własnego env.
model InstagramToken {
  id        String   @id @default("singleton")
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  customerEmail  String
  customerName   String
  phone          String
  deliveryMethod String
  address        String?
  postalCode     String?
  city           String?
  inpostPoint    String?
  paymentMethod  String
  // Zakup na firmę — wypełnione tylko, gdy klient zaznaczył fakturę VAT.
  // Adres firmy trzymamy w jednej linii, bo służy wyłącznie do wystawienia faktury.
  companyName    String?
  companyNip     String?
  companyAddress String?
  // "oczekuje" | "oplacone" | "nieudane" — ustawia webhook HotPay. Default
  // "oplacone" zostaje tylko dla starszych zamówień sprzed integracji bramki.
  paymentStatus  String      @default("oplacone")
  paymentRef     String?
  subtotalCents  Int
  discountCents  Int         @default(0)
  totalCents     Int
  status         String      @default("nowe")
  items          OrderItem[]
  // Konto, z którego złożono zamówienie — null to zakup jako gość (oraz
  // wszystkie zamówienia sprzed wprowadzenia tabeli User).
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  createdAt      DateTime    @default(now())

  @@index([customerEmail])
  @@index([userId])
}

// Klient, który zalogował się w sklepie (Google / Facebook). Sesje są w JWT,
// więc ta tabela nie służy do logowania — zapisujemy ją przy każdym wejściu,
// żeby panel mógł policzyć konta. Admini się tu nie trafiają (lib/users.ts).
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  provider    String // "google" | "facebook"
  loginCount  Int      @default(1)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  orders      Order[]
}

model OrderItem {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String
  title       String
  image       String
  size        String
  quantity    Int
  priceCents  Int
}

// Szablon tabeli rozmiarów — jeden na krój (np. „Koszulka oversize”), przypisywany wielu produktom.
model SizeChart {
  id           String    @id @default(cuid())
  name         String
  illustration String?
  sizes        String[]
  rows         Json // [{ label: "A", description: "Długość", values: ["69", "72", ...] }]
  note         String?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
